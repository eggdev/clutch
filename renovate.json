{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "dependencyDashboard": false,
  "postUpgradeTasks": {
    "commands": ["node tools/release/renovate-changeset.mjs"],
    "dataFileTemplate": "{{{branchName}}}\n{{{prTitle}}}",
    "fileFilters": [".changeset/renovate-*.md"],
    "executionMode": "branch"
  },
  "github-actions": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "3 days",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "groupName": "Nx, oxlint and oxfmt",
      "matchPackageNames": ["nx", "@nx/**", "oxlint", "oxfmt"]
    }
  ]
}
