import { <%= propertyName %> } from '@repo/<%= packageName %>/contract/<%= packageName %>';
import { serverChange } from '@repo/sync/commands/server-change.server';
import { Effect } from 'effect';

/**
 * The server half of `<%= packageName %>/<%= fileName %>`. Until you write it, each run is
 * refused. Write the owner records with `db`, and return each record it
 * changed. The access rule runs before `run`, so `run` never checks access.
<% if (access === 'group') { %> * `group` names the sync group of the record that the change writes. It
 * returns `null` until you write it, so every run is refused.
<% } %> */
export const <%= propertyName %>Server = serverChange(<%= propertyName %>, {
<% if (access === 'group') { %>  // Returns null until you write it, so every run is refused.
  group: () => Effect.succeed(null),
<% } %>  run: (_input, { refuse }) =>
