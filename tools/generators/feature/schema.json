{
  "$schema": "https://json-schema.org/schema",
  "$id": "feature",
  "title": "Add a feature",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The feature name, in kebab case, such as billing.",
      "$default": { "$source": "argv", "index": 0 }
    }
  },
  "required": ["name"]
}
