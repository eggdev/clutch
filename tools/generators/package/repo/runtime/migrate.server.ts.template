import type { DrizzleDatabase } from '@repo/sync/service/database';
import { migratePackage } from '@repo/sync/service/migrations';

/** Runs the migrations of the <%= title %> tables. drizzle-kit writes them. */
export function migrate<%= className %>(db: DrizzleDatabase) {
  return migratePackage(db, '<%= fileName %>', new URL('../repo/migrations', import.meta.url));
}
