#!/bin/sh
# Conventional Commits: type(scope)!: subject.
# See docs/contributing/setup/checks.md#git-hooks.
command -v mise >/dev/null 2>&1 || {
  echo "commit-msg: mise is not on PATH. Install it from https://mise.jdx.dev, then commit again." >&2
  exit 1
}
exec mise exec -- bun run hooks:commit-msg "$1"
