{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  // Each entry needs a reason. Knip finds most entries itself, from package.json
  // scripts and Nx targets. Each app and package is a workspace, so it gets
  // its own entries.
  "workspaces": {
    ".": {
      "entry": [
        // Bun test runs every test file.
        "tools/**/*.test.{ts,tsx}",
        // Lint-staged loads this config through --config in the hooks:pre-commit script.
        "tools/hooks/paths.mjs",
        // Claude Code and Codex run the agent hooks from .claude/settings.json and .codex/hooks.json.
        ".agents/hooks/*.ts",
        // tools/journeys/run.ts passes this config to Playwright through --config.
        "tools/journeys/playwright.config.ts",
        // Renovate runs this as a post-upgrade task from renovate.json.
        "tools/release/renovate-changeset.mjs",
      ],
      "project": ["tools/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      // tools/dev.ts runs node_modules/.bin/portless as a child process, which
      // knip cannot read.
      "ignoreDependencies": ["portless"],
      // Unlisted binaries: mise.toml installs these, so no package lists them. check-workflow-lint runs them.
      "ignoreBinaries": ["actionlint", "zizmor"],
    },
    "apps/api": {
      // The dev target runs this file with `bun --watch`, which knip cannot read.
      "entry": ["src/main.ts", "**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "apps/app": {
      // The One runtime loads the route files under app/ and the native setup
      // file, and react-native.config.cjs loads the native commands. The native
      // bundle loads the lib/*.native files by platform, which knip cannot read.
      "entry": [
        "react-native.config.cjs",
        "fingerprint.config.cjs",
        // Vite loads the One plugin and the app's build settings by file name.
        "vite.config.ts",
        // Expo loads the app config by its file name.
        "app.config.ts",
        "native-setup.ts",
        // Each platform's file loads by its suffix, which knip does not read.
        "lib/*.native.{ts,tsx}",
        "app/**/*.{ts,tsx}",
      ],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      // Expo reads app.json and app.config.ts for its own default modules, which
      // the app does not install.
      "expo": false,
      // The One plugin loads the route tree when knip loads the Vite config,
      // and no route tree exists before the first route is generated.
      "vite": false,
      "ignoreDependencies": [
        // The global stylesheet and the env types load Tailwind and NativeWind
        // through CSS `@import` and a triple-slash reference, which knip does not read.
        "tailwindcss",
        "nativewind",
        // The native build links each native module that the app lists, so the
        // app lists the SQLite library that packages/sync imports.
        "@op-engineering/op-sqlite",
        // tools/native/build.ts loads the fingerprint tool from the app.
        "@expo/fingerprint",
        // One loads the compiler for `react: { compiler: true }` in vite.config.ts.
        "babel-plugin-react-compiler",
      ],
    },
    "tools/generators": {
      // Nx loads each generator through generators.json.
      "entry": ["*/generator.ts", "**/*.test.ts"],
      "project": ["**/*.ts"],
    },
    "features/*": {
      // A gate is the way into its feature. A new feature has no caller yet:
      // the first button or link that opens it calls the gate. Playwright runs
      // each journey through tools/journeys/playwright.config.ts.
      "entry": ["gate.ts", "**/*.test.{ts,tsx}", "journeys/*.pw.ts", "journeys/*.journey.ts"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "packages/*": {
      // A contract declares each record, command and load function. A new one
      // has no reader until the first screen uses it, and the contract check
      // loads each contract file by path. A `.native` file replaces its twin
      // in the native bundle, so the bundler loads it by suffix, which knip
      // does not read.
      "entry": [
        "contract/*.ts",
        "runtime/*.native.{ts,tsx}",
        "ui/*.native.{ts,tsx}",
        "**/*.test.{ts,tsx}",
      ],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "packages/journeys": {
      // The accessibility helper that a web journey imports. A project with no
      // web journey has no caller for it yet, so this entry keeps knip from
      // flagging it. The journey generator's template imports it. The same
      // holds for `snap` in testing/visual.ts until a journey snaps a screen,
      // and for `outcomes` in testing/outcome.ts and the helpers of
      // testing/inbox.ts until a core journey exists, and for `ownOrganization`
      // in testing/organization.ts until a journey takes an organization. The
      // same holds for `poolState`, `records` and `settled` in testing/pool.ts,
      // for `callTool` in testing/tools.ts and for the screen checks in
      // testing/screen.ts, until a journey reads the pool, calls a tool or checks a screen.
      "entry": [
        "testing/a11y.ts",
        "testing/visual.ts",
        "testing/outcome.ts",
        "testing/inbox.ts",
        "testing/organization.ts",
        "testing/pool.ts",
        "testing/tools.ts",
        "testing/screen.ts",
      ],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "{apps,features,packages}/*": {
      // Bun test runs every test file.
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
  },
}
