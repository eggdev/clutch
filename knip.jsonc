{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  // Each entry needs a reason. Knip finds most entries itself, from package.json
  // scripts and Nx targets. Each app and package is a workspace, so it gets
  // its own entries.
  "workspaces": {
    ".": {
      "entry": [
        // Bun test runs every test file.
        "tools/**/*.test.{ts,tsx}",
        // Lint-staged loads this config through --config in the hooks:pre-commit script.
        "tools/hooks/paths.mjs",
        // Claude Code and Codex run the agent hooks from .claude/settings.json and .codex/hooks.json.
        ".agents/hooks/*.ts",
        // tools/journeys/run.ts passes this config to Playwright through --config.
        "tools/journeys/playwright.config.ts",
      ],
      "project": ["tools/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      // tools/dev.ts runs node_modules/.bin/portless as a child process, which
      // knip cannot read.
      "ignoreDependencies": ["portless"],
      // mise.toml installs these, so no package lists them. check-workflow-lint runs them.
      "ignoreBinaries": ["actionlint", "zizmor"],
    },
    "apps/api": {
      // The dev target runs this file with `bun --watch`, which knip cannot read.
      "entry": ["src/main.ts", "**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "apps/web": {
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      // The token file loads Tailwind through a CSS `@import`, which knip does
      // not read. `@tailwindcss/vite` also needs it as a peer.
      "ignoreDependencies": ["tailwindcss"],
    },
    "tools/generators": {
      // Nx loads each generator through generators.json.
      "entry": ["*/generator.ts", "**/*.test.ts"],
      "project": ["**/*.ts"],
    },
    "features/*": {
      // A gate is the way into its feature. A new feature has no caller yet:
      // the first button or link that opens it calls the gate. Playwright runs
      // each journey through tools/journeys/playwright.config.ts.
      "entry": ["gate.ts", "**/*.test.{ts,tsx}", "journeys/*.pw.ts"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "packages/*": {
      // A model is how screens read a record. A new model has no reader until
      // the first screen uses it.
      "entry": ["models/*.ts", "**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "{apps,features,packages}/*": {
      // Bun test runs every test file.
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
  },
}
