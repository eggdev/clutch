{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  // Each entry needs a reason. Knip finds most entries itself, from package.json
  // scripts and Nx targets. Each app and package is a workspace, so it gets
  // its own entries.
  "workspaces": {
    ".": {
      "entry": [
        // Bun test runs every test file.
        "tools/**/*.test.{ts,tsx}",
        // Lint-staged loads this config through --config in the hooks:pre-commit script.
        "tools/hooks/paths.mjs",
      ],
      "project": ["tools/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "apps/api": {
      // The dev target runs this file with `bun --watch`, which knip cannot read.
      "entry": ["src/main.ts", "**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
    "apps/web": {
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      // The token file loads Tailwind through a CSS `@import`, which knip does
      // not read. `@tailwindcss/vite` also needs it as a peer.
      "ignoreDependencies": ["tailwindcss"],
    },
    "{apps,features,packages}/*": {
      // Bun test runs every test file.
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
    },
  },
}
