{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [
    { "actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "pull_request" },
    { "actor_type": "Integration", "actor_id": "vars.CLUTCH_APP_ID", "bypass_mode": "always" }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "validate", "integration_id": 15368 },
          { "context": "journeys", "integration_id": 15368 },
          { "context": "secrets", "integration_id": 15368 },
          { "context": "commits", "integration_id": 15368 },
          { "context": "sast", "integration_id": 15368 },
          { "context": "agent-review", "integration_id": 15368 }
        ]
      }
    }
  ]
}
