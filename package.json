{
  "name": "clutch",
  "version": "0.9.3",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "features/*",
    "packages/*",
    "tools/generators"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun tools/hooks/install.ts",
    "hooks:pre-commit": "lint-staged --concurrent false --config tools/hooks/paths.mjs",
    "hooks:pre-push": "bun tools/hooks/pre-push.ts",
    "hooks:commit-msg": "bun tools/hooks/commit-msg.ts",
    "validate": "CI=1 nx run-many -t typecheck test lint format-check lint-policy-test skill-tests audit-prod checks",
    "check": "nx run-many -t typecheck lint format-check",
    "dev": "bun tools/dev.ts",
    "native:build": "bun tools/native/build.ts",
    "journey": "bun tools/journeys/run.ts",
    "format": "nx run-many -t format",
    "recap:classify": "bun tools/recap/classify-primitives.ts",
    "recap:upsert": "bun tools/recap/upsert-recap-block.ts",
    "clutch": "bun tools/clutch.ts",
    "pr": "bun tools/github/pr.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@nx/js": "23.3.0",
    "@nx/oxlint": "23.3.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/node": "22.20.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "babel-plugin-react-compiler": "1.0.0",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "nx": "23.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.88.0",
    "portless": "0.15.12",
    "stylelint": "17.16.0",
    "stylelint-high-performance-animation": "2.0.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "ultracite": "7.12.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "undici": "7.29.1"
  },
  "packageManager": "bun@1.4.2",
  "nx": {
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "oxlint tools oxlint.config.ts stylelint.config.ts",
            "stylelint \"**/*.css\" --allow-empty-input --ignore-path .gitignore",
            "bun tools/lint/check-manifests.ts"
          ],
          "parallel": false
        }
      },
      "format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "oxfmt --write ."
        },
        "cache": false
      },
      "format-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "oxfmt --check ."
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsgo -p tools/tsconfig.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/test-budget.ts 60 -- bun test tools --path-ignore-patterns 'tools/lint/**'"
        }
      },
      "lint-policy-test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/test-budget.ts 60 -- bun test tools/lint"
        }
      },
      "check-docs-file-refs": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-docs-file-refs.ts"
        },
        "cache": false
      },
      "check-docs-temporal": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-docs-temporal.ts"
        },
        "cache": false
      },
      "check-suppressions": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-suppressions.ts"
        },
        "cache": false
      },
      "check-structure": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-structure.ts"
        },
        "cache": false
      },
      "check-db": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-db.ts"
        },
        "cache": false
      },
      "check-terms": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-terms.ts"
        },
        "cache": false
      },
      "check-commands": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-commands.ts"
        },
        "cache": false
      },
      "check-vendor-leaks": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-vendor-leaks.ts"
        },
        "dependsOn": [
          {
            "projects": "*",
            "target": "typecheck"
          }
        ],
        "cache": false
      },
      "check-bundle": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-bundle.ts"
        },
        "cache": false
      },
      "check-sentences": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-sentences.ts"
        },
        "cache": false
      },
      "check-agent-hooks": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-agent-hooks.ts"
        },
        "cache": false
      },
      "check-docs-claims": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-docs-claims.ts"
        },
        "cache": false
      },
      "check-decisions": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-decisions.ts"
        },
        "cache": false
      },
      "check-file-size": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-file-size.ts"
        },
        "cache": false
      },
      "check-primitives": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-primitives.ts"
        },
        "cache": false
      },
      "check-kickoff-slots": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-kickoff-slots.ts"
        },
        "cache": false
      },
      "knip": {
        "executor": "nx:run-commands",
        "options": {
          "command": "knip"
        },
        "cache": false
      },
      "check-user-docs": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-user-docs.ts"
        },
        "cache": false
      },
      "check-workflows": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-workflows.ts"
        },
        "cache": false
      },
      "check-workflow-lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "actionlint && zizmor --min-severity medium .github/workflows"
        },
        "cache": false
      },
      "check-dependency-overrides": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-dependency-overrides.ts"
        },
        "cache": false
      },
      "audit-prod": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/audit-prod.ts"
        },
        "cache": false
      },
      "checks": {
        "executor": "nx:noop",
        "dependsOn": [
          "check-docs-file-refs",
          "check-docs-temporal",
          "check-suppressions",
          "check-terms",
          "check-docs-claims",
          "check-agent-hooks",
          "check-structure",
          "check-sentences",
          "check-commands",
          "check-vendor-leaks",
          "check-bundle",
          "check-decisions",
          "check-file-size",
          "check-kickoff-slots",
          "check-primitives",
          "check-workflows",
          "check-workflow-lint",
          "check-dependency-overrides",
          "check-user-docs",
          "knip",
          "check-migrations",
          "check-db",
          "check-lockfile",
          "check-skills",
          "skill-tests",
          "check-guardrail-coverage",
          "check-transaction-safe",
          "check-test-integrity",
          "check-journeys",
          "check-clutch",
          "check-clutch-issues",
          "check-changeset"
        ]
      },
      "check-journeys": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-journeys.ts"
        },
        "cache": false
      },
      "journeys": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/journeys/run.ts --all"
        },
        "cache": false
      },
      "check-guardrail-coverage": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-guardrail-coverage.ts"
        },
        "cache": false
      },
      "check-transaction-safe": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-transaction-safe.ts"
        },
        "cache": false
      },
      "check-test-integrity": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-test-integrity.ts"
        },
        "cache": false
      },
      "check-migrations": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-migrations.ts"
        },
        "cache": false
      },
      "check-lockfile": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun install --frozen-lockfile"
        },
        "cache": false
      },
      "skill-tests": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/test-budget.ts 60 -- python3 tools/run-skill-tests.py"
        },
        "cache": false
      },
      "check-skills": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-skills.ts"
        },
        "cache": false
      },
      "check-clutch": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/clutch.ts doctor --check"
        },
        "cache": false
      },
      "check-clutch-issues": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/clutch.ts issues --check"
        },
        "cache": false
      },
      "check-changeset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-changeset.ts"
        },
        "cache": false
      }
    }
  }
}
