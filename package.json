{
  "name": "project-template",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun tools/hooks/install.ts",
    "hooks:pre-commit": "lint-staged --concurrent false --config tools/hooks/paths.mjs",
    "hooks:pre-push": "bun tools/hooks/pre-push.ts",
    "validate": "CI=1 nx run-many -t typecheck test lint format-check lint-policy-test audit-prod checks",
    "check": "nx run-many -t typecheck lint format-check",
    "format": "nx run project-template:format",
    "recap:classify": "bun tools/recap/classify-primitives.ts",
    "recap:upsert": "bun tools/recap/upsert-recap-block.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@nx/js": "23.2.1",
    "@nx/oxlint": "23.2.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "nx": "23.2.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "ultracite": "7.12.2",
    "wrangler": "4.146.0",
    "yaml": "2.9.1"
  },
  "packageManager": "bun@1.4.2",
  "nx": {
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "oxlint tools oxlint.config.ts",
            "bun tools/lint/check-manifests.ts"
          ],
          "parallel": false
        }
      },
      "format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "oxfmt --write ."
        },
        "cache": false
      },
      "format-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "oxfmt --check ."
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsgo -p tools/tsconfig.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/test-budget.ts 60 -- bun test tools --path-ignore-patterns 'tools/lint/**'"
        }
      },
      "lint-policy-test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/test-budget.ts 60 -- bun test tools/lint"
        }
      },
      "check-docs-file-refs": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-docs-file-refs.ts"
        },
        "cache": false
      },
      "check-docs-temporal": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-docs-temporal.ts"
        },
        "cache": false
      },
      "check-decisions": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-decisions.ts"
        },
        "cache": false
      },
      "check-file-size": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-file-size.ts"
        },
        "cache": false
      },
      "check-primitives": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-primitives.ts"
        },
        "cache": false
      },
      "check-kickoff-slots": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-kickoff-slots.ts"
        },
        "cache": false
      },
      "knip": {
        "executor": "nx:run-commands",
        "options": {
          "command": "knip"
        },
        "cache": false
      },
      "check-user-docs": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-user-docs.ts"
        },
        "cache": false
      },
      "check-workflows": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-workflows.ts"
        },
        "cache": false
      },
      "check-dependency-overrides": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-dependency-overrides.ts"
        },
        "cache": false
      },
      "audit-prod": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun audit --prod --audit-level=moderate"
        },
        "cache": false
      },
      "checks": {
        "executor": "nx:noop",
        "dependsOn": [
          "check-docs-file-refs",
          "check-docs-temporal",
          "check-decisions",
          "check-file-size",
          "check-kickoff-slots",
          "check-primitives",
          "check-workflows",
          "check-dependency-overrides",
          "check-user-docs",
          "knip",
          "check-migrations",
          "check-lockfile"
        ]
      },
      "check-migrations": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/check-migrations.ts"
        },
        "cache": false
      },
      "check-lockfile": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun install --frozen-lockfile"
        },
        "cache": false
      }
    }
  }
}
