{
  "name": "web",
  "private": true,
  "type": "module",
  "dependencies": {
    "@features/notes": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/notes": "workspace:*",
    "@repo/sync": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "nx": {
    "tags": [],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "vite",
          "cwd": "apps/web"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vite build && bun ../../tools/web/service-worker.ts dist",
          "cwd": "apps/web"
        },
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
