{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "env -u CI -u EAS_BUILD one patch",
    "build:web": "one build && bun ../../tools/web/service-worker.ts dist/client",
    "clean": "one clean",
    "dev": "one dev",
    "generate:routes": "one generate-routes",
    "prebuild:native": "one prebuild"
  },
  "dependencies": {
    "@features/notes": "workspace:*",
    "@op-engineering/op-sqlite": "19.0.2",
    "@react-navigation/native": "~7.3.16",
    "@repo/access": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/notes": "workspace:*",
    "@repo/sync": "workspace:*",
    "expo": "~57.0.30",
    "expo-crypto": "~57.0.4",
    "one": "1.27.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.20.14",
    "@react-native-community/cli": "20.2.0",
    "@repo/app-build": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "babel-plugin-react-compiler": "1.0.0",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:product"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "one dev",
          "cwd": "apps/app"
        }
      },
      "generate:routes": {
        "cache": false,
        "outputs": [
          "{projectRoot}/app/routes.d.ts"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "generate:routes"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "tsgo --build apps/app/tsconfig.json"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/test-budget.ts 60 -- bun test apps/app"
        }
      }
    }
  }
}
