{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "models.yaml",
  "description": "Each model that an agent or a scorer in the tree may name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["models"],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "harness"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\S+$",
            "description": "The model id that the harness takes, such as claude-opus-5-5."
          },
          "harness": {
            "type": "string",
            "enum": ["claude", "codex", "qwen"],
            "description": "The agent CLI that runs the model."
          },
          "where": {
            "type": "string",
            "pattern": "\\S",
            "description": "Where the model runs and how to reach it."
          }
        }
      }
    }
  }
}
