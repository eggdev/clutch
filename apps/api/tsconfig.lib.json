{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test/**",
    "out-tsc/**",
    "node_modules/**",
    "dist/**"
  ],
  "references": [
    {
      "path": "../../packages/access/tsconfig.lib.json"
    },
    {
      "path": "../../packages/sync/tsconfig.lib.json"
    },
    {
      "path": "../../packages/notes/tsconfig.lib.json"
    },
    {
      "path": "../../packages/identity/tsconfig.lib.json"
    }
  ]
}
