{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/spec",
    "tsBuildInfoFile": "out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "types": ["bun"],
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  },
  "include": ["**/*.test.ts", "**/*.test.tsx", "testing/**/*.ts", "testing/**/*.tsx"],
  "exclude": ["out-tsc/**", "node_modules/**"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../sync/tsconfig.spec.json"
    },
    {
      "path": "../identity/tsconfig.spec.json"
    },
    {
      "path": "../access/tsconfig.spec.json"
    }
  ]
}
