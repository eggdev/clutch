{
  "name": "@repo/sync",
  "private": true,
  "type": "module",
  "dependencies": {
    "@effect/sql-pg": "4.0.7",
    "@effect/sql-pglite": "4.0.7",
    "@electric-sql/pglite": "0.5.13",
    "@op-engineering/op-sqlite": "19.0.2",
    "@repo/identity": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.7",
    "idb": "8.0.4",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "1.0.0-rc.5",
    "react-dom": "19.2.3"
  },
  "nx": {
    "tags": [
      "type:package"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun tools/test-budget.ts 60 -- bun test packages/sync --path-ignore-patterns '**/*.browser.test.ts'"
        }
      },
      "db-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit generate",
          "cwd": "packages/sync"
        }
      }
    }
  }
}
