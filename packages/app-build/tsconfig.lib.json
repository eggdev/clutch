{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "lib": ["es2024"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": ["runtime/**/*.ts"],
  "exclude": ["**/*.test.ts", "out-tsc/**", "node_modules/**"]
}
